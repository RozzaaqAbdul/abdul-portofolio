---
import { experience } from "../data/portfolio.ts";
---

<section
  id="experience"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">My journey</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Experience</h3>

    <div class="flex flex-col gap-6">
      {
        experience.map((job) => (
          <div class="bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-6 md:p-8 hover:border-[var(--sec)] transition-colors duration-300">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 mb-4">
              <div>
                <h4 class="text-xl md:text-2xl font-semibold">{job.role}</h4>
                <p class="text-[var(--sec)]">{job.company}</p>
              </div>
              <span class="text-sm text-[var(--white-icon)] md:whitespace-nowrap">
                {job.period}
              </span>
            </div>
            <ul class="space-y-2 text-[var(--white-icon)]">
              {job.points.map((point) => (
                <li class="flex gap-3">
                  <span class="text-[var(--sec)] mt-1">▸</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
